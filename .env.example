# E-Salle ENSAA - Environment Variables Example
# Copy this file to .env and fill in your actual values

# PostgreSQL Database Configuration
POSTGRES_DB=esalle_ensaa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here

# Application Database Connection
DB_URL=jdbc:postgresql://postgres:5432/esalle_ensaa
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# Hibernate Configuration
# Options: update (development) | validate (production) | create | create-drop
HIBERNATE_DDL_AUTO=update

# Java Options
JAVA_OPTS=-Xmx512m -Xms256m -Dspring.profiles.active=docker

# Application Settings
SEED_DB=true
